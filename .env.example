# 商品目录册 PPT 输出根目录，Linux 服务器路径
PPT_CATALOG_ROOT=/data/share/yaq/ppt/catalog

# Windows/Samba 映射盘路径前缀，用于飞书回复给业务人员
PPT_WINDOWS_SHARE_PREFIX=Z:\\yaq\\ppt\\catalog

# 固定使用中国时区，避免服务器 UTC 导致 09:35 这种时间偏差
PPT_TIMEZONE=Asia/Shanghai

# 默认页数与最大页数
PPT_DEFAULT_PAGE_COUNT=5
PPT_MAX_PAGE_COUNT=20

# 文件名长度限制，避免 Windows 路径过长
PPT_FILENAME_MAX_CHARS=56

# 是否在同名目录存在时自动追加 -01/-02
PPT_AUTO_DEDUP=1

# v1.5 生产默认强制 MiniMax 生图；不要改成 placeholder/off，否则会退化成测试模式
PPT_IMAGE_MODE=minimax
PPT_REQUIRE_IMAGES=1

# MiniMax image-01 接口
# 也可以不写 MINIMAX_API_KEY，让脚本尝试从 ~/.openclaw/openclaw.json 自动读取 minimax provider 的 key
MINIMAX_API_KEY=
# v1.5 默认先试你指定的 api.minimax.com；若 DNS/请求失败，会自动尝试 api.minimaxi.com 和 api.minimax.io
MINIMAX_IMAGE_API_URL=https://api.minimax.com/v1/image_generation
# 可选：完全自定义候选接口，逗号分隔；留空则使用默认候选列表
MINIMAX_IMAGE_API_URL_CANDIDATES=
MINIMAX_AUTO_FALLBACK_HOSTS=1
# 可选：服务器需要代理才能解析/访问 MiniMax 时填写，例如 http://127.0.0.1:17897
MINIMAX_PROXY_URL=
MINIMAX_IMAGE_MODEL=image-01
MINIMAX_IMAGE_RESPONSE_FORMAT=base64
MINIMAX_IMAGE_TIMEOUT=180
MINIMAX_PROMPT_OPTIMIZER=1
MINIMAX_VERIFY_SSL=1
MINIMAX_NETWORK_PRECHECK=0
