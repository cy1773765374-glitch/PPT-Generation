# 商品目录册 PPT 输出根目录，Linux 服务器路径
PPT_CATALOG_ROOT=/data/share/yaq/ppt/catalog

# Windows/Samba 映射盘路径前缀，用于飞书回复给业务人员
PPT_WINDOWS_SHARE_PREFIX=Z:\\yaq\\ppt\\catalog

# 固定使用中国时区，避免服务器 UTC 造成文件名时间偏差
PPT_TIMEZONE=Asia/Shanghai

# 默认页数与最大页数；显式英文 10-page / Pages 2-10 会覆盖默认值
PPT_DEFAULT_PAGE_COUNT=5
PPT_MAX_PAGE_COUNT=20

# 文件名长度限制，避免 Windows 路径过长
PPT_FILENAME_MAX_CHARS=56
PPT_AUTO_DEDUP=1

# 渲染后端：auto=优先 PPT-master，失败降级 python-pptx；pptmaster=强制 PPT-master；python_pptx=旧渲染器
# 生产建议：PPT_RENDER_BACKEND=pptmaster + PPT_MASTER_STRICT=1
PPT_RENDER_BACKEND=pptmaster
PPT_MASTER_ROOT=/home/cy/.openclaw/workspace-PPT-Generation/vendor/ppt-master
PPT_MASTER_STRICT=1
PPT_MASTER_TIMEOUT=240
PPT_MASTER_SKIP_QUALITY=0
# 默认质量检查失败不阻断导出，只写入 pptmaster_pipeline.log；需要硬阻断时设为 1
PPT_MASTER_QUALITY_HARD_GATE=0
PPT_MASTER_PYTHON=python3

# 生产默认强制 MiniMax 生图；离线布局测试才使用 placeholder
PPT_IMAGE_MODE=minimax
PPT_REQUIRE_IMAGES=1

# 图片场景策略：auto=用户明确要求场景才生成场景；product_only=强制白底/棚拍；lifestyle=强制场景图
PPT_IMAGE_SCENE_MODE=auto

# MiniMax image-01 接口
# 可以不写 MINIMAX_API_KEY，让脚本尝试从 ~/.openclaw/openclaw.json 自动读取 minimax provider key
MINIMAX_API_KEY=
MINIMAX_IMAGE_API_URL=https://api.minimax.com/v1/image_generation
MINIMAX_IMAGE_API_URL_CANDIDATES=
MINIMAX_AUTO_FALLBACK_HOSTS=1
MINIMAX_PROXY_URL=
MINIMAX_IMAGE_MODEL=image-01
MINIMAX_IMAGE_RESPONSE_FORMAT=base64
MINIMAX_IMAGE_TIMEOUT=180
MINIMAX_PROMPT_OPTIMIZER=0
MINIMAX_VERIFY_SSL=1
MINIMAX_NETWORK_PRECHECK=0
